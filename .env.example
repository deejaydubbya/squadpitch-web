# =============================================================================
# Squadpitch Web — environment variables
#
# This app uses @auth0/nextjs-auth0 v4. Variable names changed from v3:
#   v3 AUTH0_BASE_URL          → v4 APP_BASE_URL
#   v3 AUTH0_ISSUER_BASE_URL   → v4 AUTH0_DOMAIN (no scheme, no trailing slash)
#
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time.
# Anything else stays server-only (Next.js route handlers + middleware).
# =============================================================================

# ── Auth0 (REQUIRED) ─────────────────────────────────────────────────────────
AUTH0_DOMAIN=squadpitch.us.auth0.com                   # tenant host, no scheme/slash
AUTH0_CLIENT_ID=                                       # SPA / regular web app client id
AUTH0_CLIENT_SECRET=                                   # client secret (server-only)
AUTH0_SECRET=                                          # cookie encryption — `openssl rand -hex 32`
AUTH0_AUDIENCE=https://api.squadpitch.com              # must match the API audience
APP_BASE_URL=http://localhost:3000                     # canonical app origin (https://app.squadpitch.com in prod)

# ── API target ───────────────────────────────────────────────────────────────
SQUADPITCH_API_URL=http://localhost:4000               # server-side proxy target

# ── Public app URL (for OAuth popup origin checks) ───────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000              # exposed to client

# ── Sentry (OPTIONAL) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=                                # @sentry/browser DSN
NEXT_PUBLIC_SENTRY_ENVIRONMENT=                        # defaults to NODE_ENV

# ── PostHog (OPTIONAL — funnel analytics) ────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=                               # project API key (NOT a personal key)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com      # default US cloud
